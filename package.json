{
  "name": "weekend-ride-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "dev:api": "pnpm --filter @weekend-ride/api run start:dev",
    "dev:web": "pnpm --filter @weekend-ride/web run dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild"
    ]
  }
}
