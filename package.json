{
  "name": "daruka",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "start:api": "pnpm --filter @weekend-ride/api run start:prod",
    "dev:api": "pnpm --filter @weekend-ride/api run start:dev",
    "dev:web": "pnpm --filter @weekend-ride/web run dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild"
    ]
  }
}
