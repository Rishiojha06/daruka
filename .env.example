# API Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Google Maps Platform (Server-side)
# Server API key used for Routes API, Matrix API, Places API
GOOGLE_MAPS_API_KEY=your_server_api_key_here
ROUTING_PROVIDER_MODE=mock # 'mock' or 'live'

# Google Maps Platform (Client-side)
# Restricted browser key used for Maps JavaScript API rendering
VITE_GOOGLE_MAPS_API_KEY=your_browser_api_key_here
